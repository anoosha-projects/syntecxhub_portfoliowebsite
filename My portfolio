<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Personal Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="logo">MyPortfolio</div>
        <nav>
            <ul>
                <li><a href="#hero">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="hero-section">
        <div class="hero-content">
            <h1>Hi, I'm <span class="highlight">Alex Doe</span></h1>
            <p>A passionate Front-End Developer creating seamless web experiences.</p>
            <a href="#projects" class="btn">View My Work</a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
        <h2>About Me</h2>
        <div class="about-container">
            <div class="about-text">
                <p>I build clean, responsive, and user-friendly websites. I specialize in turning complex designs into semantic, high-performance code using HTML, CSS, and modern layouts.</p>
                <h3>My Skills</h3>
                <div class="skills">
                    <span class="skill-badge">HTML5</span>
                    <span class="skill-badge">CSS3</span>
                    <span class="skill-badge">Flexbox & Grid</span>
                    <span class="skill-badge">Responsive Design</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects-section">
        <h2>My Projects</h2>
        <div class="projects-grid">
            <!-- Project 1 -->
            <div class="project-card">
                <div class="project-info">
                    <h3>E-commerce Layout</h3>
                    <p>A modern online storefront layout built entirely with CSS Grid.</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>
            </div>
            <!-- Project 2 -->
            <div class="project-card">
                <div class="project-info">
                    <h3>Weather Application</h3>
                    <p>An interactive dynamic app layout designed for all mobile screen sizes.</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>
            </div>
            <!-- Project 3 -->
            <div class="project-card">
                <div class="project-info">
                    <h3>Task Dashboard</h3>
                    <p>A sleek productivity dashboard layout with automated CSS dark mode styling.</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <h2>Get In Touch</h2>
        <p>Have a project in mind? Let's work together!</p>
        <form class="contact-form" onsubmit="event.preventDefault();">
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea placeholder="Your Message" rows="5" required></textarea>
            <button type="submit" class="btn">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Alex Doe. All rights reserved.</p>
    </footer>

</body>
</html>
